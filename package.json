{
  "name": "mailspring-offline-translator",
  "version": "1.0.0",
  "description": "Private, zero-cloud offline email translator for Mailspring using Apple Translation Framework.",
  "main": "lib/core/main.js",
  "displayName": "Mailspring Offline Translator",
  "title": "Offline Translator",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/bispitalieri/mailspring-offline-translator"
  },
  "license": "MIT",
  "engines": {
    "mailspring": ">=1.6.3"
  },
  "keywords": [
    "mailspring",
    "plugin",
    "offline",
    "translation",
    "privacy",
    "apple-translation"
  ],
  "scripts": {
    "build": "tsc",
    "package": "bash scripts/package-plugin.sh",
    "debug": "npm run package && rm -rf \"/Users/biagio/Library/Application Support/Mailspring/packages/mailspring-offline-translator\" && cp -R dist-package/mailspring-offline-translator \"/Users/biagio/Library/Application Support/Mailspring/packages/\""
  },
  "windowTypes": {
    "default": true,
    "composer": true
  },
  "dependencies": {
    "@browsermt/bergamot-translator": "^0.4.9",
    "@huggingface/transformers": "^4.3.2",
    "adm-zip": "^0.6.1",
    "ctranslate2": "^1.0.0",
    "languagedetect": "^2.0.0"
  },
  "devDependencies": {
    "@electron/remote": "^2.1.4",
    "@types/adm-zip": "^0.6.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true
  }
}
