{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "jsx": "react",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "./lib",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "mailspring-exports": ["/Users/biagio/Sites/Mailspring/app/src/global/mailspring-exports.d.ts"],
      "mailspring-component-kit": ["/Users/biagio/Sites/Mailspring/app/src/global/mailspring-component-kit.d.ts"]
    },
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "lib",
    "helpers"
  ]
}
